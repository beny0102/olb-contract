{
  "name": "@olb/contract",
  "version": "0.2.0",
  "description": "Canonical event and telemetry contract for Open League Baseball",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "generated/ts",
    "src",
    "fixtures",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./types": "./generated/ts/event.d.ts",
    "./types/event": "./generated/ts/event.d.ts",
    "./types/track": "./generated/ts/track.d.ts",
    "./types/realtime": "./generated/ts/realtime.d.ts",
    "./schema/*": "./dist/schema/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "check": "node scripts/build.mjs && git diff --exit-code -- dist generated"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
